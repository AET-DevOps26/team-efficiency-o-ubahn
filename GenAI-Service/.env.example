# ---------------------------------------------------------------------------
# GenAI Service configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored, so
# your Logos key never gets committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Which inference backend to use: "cloud" (Logos / OpenAI-compatible) or "local".
GENAI_PROVIDER=cloud

# ---------- Cloud provider (Logos @ TUM) ----------
# You receive this lg-... key from your tutor. Requires the TUM network /
# eduVPN to reach the prod instance.
LOGOS_API_KEY=lg-replace-me
LOGOS_BASE_URL=https://logos.aet.cit.tum.de/v1
LOGOS_MODEL=openai/gpt-oss-120b

# ---------- Local provider (Ollama / GPT4All / llama.cpp) ----------
# Any server that exposes an OpenAI-compatible /v1 endpoint works here.
# Ollama example: run `ollama serve` then `ollama pull llama3`.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3
LOCAL_API_KEY=not-needed

# ---------- Generation tuning ----------
GENAI_TEMPERATURE=0.7
GENAI_REQUEST_TIMEOUT=60

# ---------- Server ----------
GENAI_PORT=8084
